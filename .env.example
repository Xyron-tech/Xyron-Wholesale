NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
MONGODB_URI=mongodb://127.0.0.1:27017/xyron_wholesale
MONGODB_MAX_POOL_SIZE=100
SUPER_ADMIN_NAME=Xyron Super Admin
# Set these before running the seed script.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=
XYRON_PIN_DATABASE_PATH=

# Optional image storage: provide CLOUDINARY_URL or all three values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
